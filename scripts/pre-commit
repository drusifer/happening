#!/bin/bash
# Pre-commit hook: scan staged files for secrets using gitleaks

gitleaks protect --staged --config=.gitleaks.toml -v
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo ""
  echo "❌ gitleaks found potential secrets in staged files."
  echo "   Review the findings above and remove sensitive data before committing."
  echo "   To bypass (only if you're sure it's a false positive):"
  echo "     git commit --no-verify"
  exit 1
fi

# Reject filenames with characters invalid on Windows: \ : * ? " < > |
INVALID=$(git diff --cached --name-only | grep -P '[\\:*?"<>|]')
if [ -n "$INVALID" ]; then
  echo ""
  echo "❌ Filenames contain characters invalid on Windows:"
  echo "$INVALID"
  echo "   Rename using dashes or underscores before committing."
  exit 1
fi
